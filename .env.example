# ============================================================================
# UNTITLED — environment
# The app RUNS with only the two public Supabase vars set. Every † key is
# server-only and unlocks one capability; each degrades gracefully when absent.
# Never commit real values — this file documents shape only.
# ============================================================================

# --- required (public, safe in the browser bundle) --------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public site origin (used for auth redirects, OG, robots). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase service role † (server-only) ----------------------------------
# Enables: seed script, enrichment worker writes, Mux webhook updates,
# server-side image processing, hard account deletion. Find it in
# Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Search: unified multimodal embeddings (Layer A) † ----------------------
# Gemini Embedding 2 embeds text/image/audio/video into one shared space.
# Absent -> fall back to gte-small text embeddings (Edge Function), then FTS.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=1536

# --- Enrichment: vision descriptions † --------------------------------------
# Anthropic vision -> dense factual descriptions for image search + alt text.
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# --- Enrichment: transcription † --------------------------------------------
# Groq Whisper -> sung/rapped lyrics become searchable ("covers of Yellow").
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Video via Mux † --------------------------------------------------------
# Absent -> video posting is hidden gracefully; sound/image/words still work.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Verifies the video.asset.ready webhook signature.
MUX_WEBHOOK_SECRET=

# --- Feature flags ----------------------------------------------------------
# Scout mode teaser + waitlist at /scout.
ENABLE_SCOUT=false
